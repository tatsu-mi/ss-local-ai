# Auth.js / Microsoft Entra ID (single tenant)
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_TRUST_HOST=true
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0

# Supabase (server only; never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_PROFILE=gemini-embedding-001:768:retrieval-v1
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_GENERATION_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_PDF_MODEL=gemini-3.1-flash-lite
GEMINI_PDF_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_GENERATION_MAX_ATTEMPTS=4
GEMINI_EMBEDDING_MAX_ATTEMPTS=4
GEMINI_RETRY_BASE_DELAY_MS=1000
GEMINI_RETRY_MAX_DELAY_MS=8000
RAG_SIMILARITY_THRESHOLD=0.70
RAG_CANDIDATE_COUNT=10
RAG_CONTEXT_COUNT=5
MAX_QA_EMBEDDING_CHARS=1800
RAG_CITATION_VALIDATION_MODE=relaxed
MAX_PDF_BYTES=20971520
